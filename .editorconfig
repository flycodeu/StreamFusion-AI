root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.{java,py,ps1}]
indent_size = 4

[*.cmd]
end_of_line = crlf

[*.md]
trim_trailing_whitespace = false

[scripts/export-sql.ps1]
# Windows PowerShell 5.1 needs a BOM for the Chinese SQL filenames.
charset = utf-8-bom

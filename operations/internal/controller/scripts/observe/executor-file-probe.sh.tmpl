/bin/sh -c "if [ -L %[1]s ] || [ -L %[2]s ]; then printf 'SFOPS_EXECUTOR_V1\nUNSAFE\n'; elif [ -d %[1]s ] && [ ! -x %[1]s ]; then printf 'SFOPS_EXECUTOR_V1\nUNREADABLE\n'; elif [ ! -e %[2]s ]; then printf 'SFOPS_EXECUTOR_V1\nMISSING\n'; elif [ ! -r %[2]s ]; then printf 'SFOPS_EXECUTOR_V1\nUNREADABLE\n'; elif [ ! -f %[2]s ] || [ ! -x %[2]s ]; then printf 'SFOPS_EXECUTOR_V1\nNOT_EXECUTABLE\n'; %[3]selse printf 'SFOPS_EXECUTOR_V1\nPRESENT\n'; fi"
{
  "native-user-create": ["/usr/sbin/useradd", "--system", "--no-create-home", "--home-dir", "/nonexistent", "--shell", "/usr/sbin/nologin", "--user-group", "--", "$1"],
  "native-service-start": ["/usr/bin/systemctl", "enable", "--now", "--", "$1"],
  "native-ffmpeg-configure": ["/bin/sh", "./configure", "--disable-doc", "--disable-ffplay", "--disable-debug", "--enable-gpl", "--enable-version3", "--enable-libx264", "--enable-openssl"],
  "native-make-build": ["/usr/bin/make", "$1"],
  "native-python-configure": ["/bin/sh", "./configure", "$1", "--with-ensurepip=install"],
  "native-python-install": ["/usr/bin/make", "altinstall"],
  "native-redis-build": ["/usr/bin/make", "$1", "MALLOC=libc", "BUILD_TLS=yes", "redis-server", "redis-cli"],
  "native-nginx-configure": ["/bin/sh", "./configure", "$1", "$2", "$3", "--error-log-path=stderr", "--http-log-path=/dev/stdout", "--with-http_ssl_module", "--with-http_v2_module"],
  "native-zlm-configure": ["/usr/bin/cmake", "-S", "$1", "-B", "$2", "-DCMAKE_BUILD_TYPE=Release", "-DENABLE_TESTS=OFF", "-DENABLE_PYTHON=OFF", "-DENABLE_OPENSSL=ON", "-DENABLE_WEBRTC=ON", "-DENABLE_SRT=ON", "-DDISABLE_REPORT=ON"],
  "native-zlm-build": ["/usr/bin/cmake", "--build", "$1", "--parallel", "$2", "--target", "MediaServer"],
  "native-mysql-initialize": ["$1", "--no-defaults", "--initialize-insecure", "$2", "$3", "$4"],
  "native-args-mediamtx": ["$1"],
  "native-args-mysql": ["$1"],
  "native-args-redis": ["$1"],
  "native-args-nginx": ["-p", "$1", "-c", "$2", "-g", "daemon off;"],
  "native-args-zlm": ["-c", "$1", "-s", "$2", "-l", "1", "--log-dir", "$3", "--log-size", "10", "--log-slice", "3", "-m", "3"],
  "native-args-seaweedfs": ["server", "$1", "$2", "-volume.max=8", "-master.volumeSizeLimitMB=1024", "-ip=127.0.0.1", "-ip.bind=127.0.0.1", "-master.telemetry=false", "$3", "$4", "$5", "$6", "-filer", "$7", "$8", "-s3", "$9", "$10", "$11", "-s3.port.iceberg=0", "-s3.port.lance=0", "$12"],
  "docker-apt": ["/usr/bin/apt-get", "$*"],
  "docker-apt-install-simulate": ["--no-download", "--no-install-recommends", "-o", "APT::Get::AutomaticRemove=false", "-o", "DPkg::Lock::Timeout=15", "-o", "Dpkg::Options::=--force-confold", "--simulate", "--no-remove", "install", "--", "$*"],
  "docker-apt-install-apply": ["--no-download", "--no-install-recommends", "-o", "APT::Get::AutomaticRemove=false", "-o", "DPkg::Lock::Timeout=15", "-o", "Dpkg::Options::=--force-confold", "--assume-yes", "--no-remove", "install", "--", "$*"],
  "docker-apt-remove-simulate": ["--no-download", "--no-install-recommends", "-o", "APT::Get::AutomaticRemove=false", "-o", "DPkg::Lock::Timeout=15", "-o", "Dpkg::Options::=--force-confold", "--simulate", "remove", "--", "$*"],
  "docker-apt-remove-apply": ["--no-download", "--no-install-recommends", "-o", "APT::Get::AutomaticRemove=false", "-o", "DPkg::Lock::Timeout=15", "-o", "Dpkg::Options::=--force-confold", "--assume-yes", "remove", "--", "$*"],
  "docker-engine-start": ["/usr/bin/systemctl", "enable", "--now", "docker.service"]
}

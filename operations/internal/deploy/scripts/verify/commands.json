{
  "tool-java": ["java", "-version"],
  "tool-maven": ["mvn", "-version"],
  "tool-python": ["python3", "-I", "-c", "$1"],
  "tool-ffmpeg": ["ffmpeg", "-hide_banner", "-encoders"],
  "tool-codex": ["codex", "--version"],
  "tool-claude": ["claude", "--version"],
  "tool-git": ["git", "--version"],
  "tool-ffmpeg-version": ["-version"],
  "tool-sandbox-ai": ["/usr/sbin/runuser", "-u", "$1", "--", "/usr/bin/env", "-i", "$2", "PATH=/usr/bin:/bin", "$3", "$4", "$5", "DISABLE_AUTOUPDATER=1", "CLAUDE_CODE_DISABLE_NONESSENTIAL_TRAFFIC=1", "LC_ALL=C", "$6"],
  "tool-sandbox-standard": ["/usr/sbin/runuser", "-u", "$1", "--", "/usr/bin/env", "-i", "--chdir=/", "PATH=/usr/bin:/bin", "HOME=/nonexistent", "LC_ALL=C", "$2"],
  "verify-docker-info": ["/usr/bin/docker", "info", "--format", "{{.ServerVersion}}\t{{.DockerRootDir}}"],
  "verify-docker-compose": ["/usr/bin/docker", "compose", "version", "--short"],
  "verify-docker-mysql-init": ["/usr/bin/docker", "container", "exec", "$1", "cat", "/proc/1/comm"],
  "verify-docker-nginx-config": ["/usr/bin/docker", "container", "exec", "$1", "nginx", "-t"],
  "verify-docker-exec": ["/usr/bin/docker", "container", "exec", "$1"],
  "verify-mysql-docker": ["mysql", "--defaults-extra-file=/run/secrets/mysql-health.cnf", "--batch", "--skip-column-names", "--execute", "SELECT VERSION()"],
  "verify-redis-docker": ["redis-server", "--version"],
  "verify-nginx-docker": ["nginx", "-v"],
  "verify-seaweedfs-docker": ["/usr/bin/weed", "version"],
  "verify-mediamtx-docker": ["/mediamtx", "--version"],
  "verify-zlm-docker": ["/opt/media/bin/MediaServer", "--version"],
  "verify-mysql-native": ["$1", "$2", "--batch", "--skip-column-names", "--execute", "SELECT VERSION()"],
  "verify-nginx-native-config": ["$1", "-p", "$2", "-c", "$3", "-t"],
  "verify-version-java": ["-version"],
  "verify-version-maven": ["-version"],
  "verify-version-python": ["-I", "--version"],
  "verify-version-ffmpeg": ["-version"],
  "verify-official-redis": ["/usr/bin/redis-cli", "-h", "127.0.0.1", "-p", "6379", "PING"],
  "verify-official-mysql": ["/usr/bin/mysql", "--protocol=socket", "--batch", "--skip-column-names", "--execute", "SELECT VERSION()"],
  "verify-official-nginx": ["/usr/sbin/nginx", "-t"],
  "verify-observe-java": ["/usr/bin/java", "-version"],
  "verify-observe-python": ["/usr/bin/python3", "--version"],
  "verify-observe-ffmpeg": ["/usr/bin/ffmpeg", "-version"],
  "verify-observe-git": ["/usr/bin/git", "--version"],
  "verify-version-default": ["--version"],
  "verify-version-nginx": ["-v"],
  "verify-version-seaweedfs": ["version"]
}

# Copy to .env.local; replace credentials. Never commit .env.local.
SF_INSPECTOR_NODE_ID=inspection-node-1
SF_INSPECTOR_AUTH_TOKEN=replace-with-a-random-machine-token-at-least-32-characters
SF_INSPECTOR_HOST=0.0.0.0
SF_INSPECTOR_PORT=8120

# A restricted account for the inspection exchange tables only.
SF_INSPECTOR_DB_HOST=database.internal
SF_INSPECTOR_DB_PORT=3306
SF_INSPECTOR_DB_DATABASE=inspection_exchange
SF_INSPECTOR_DB_USER=inspection_worker
SF_INSPECTOR_DB_PASSWORD=replace-with-database-password
SF_INSPECTOR_DB_SSL_CA=/absolute/path/to/mysql-ca.pem

# Direct TLS, or explicitly configure a trusted reverse proxy instead.
SF_INSPECTOR_TLS_CERTFILE=/absolute/path/to/node-cert.pem
SF_INSPECTOR_TLS_KEYFILE=/absolute/path/to/node-key.pem
SF_INSPECTOR_TRUSTED_PROXY=false

# Local experiments only: use literal 127.0.0.1 and a separate disposable MySQL port.
# SF_INSPECTOR_DB_ALLOW_INSECURE_LOOPBACK=true

<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.streamfusion.platform.audit.mapper.OperationLogMapper">
    <select id="countSuccessfulBootstrap" resultType="java.lang.Long">
        SELECT COUNT(*) FROM sys_operation_log
        WHERE action = 'BOOTSTRAP' AND result = 'SUCCESS'
    </select>
</mapper>

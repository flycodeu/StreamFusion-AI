<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.streamfusion.platform.audit.mapper.AuditReferenceMapper">
    <select id="find" resultType="com.streamfusion.platform.audit.pojo.dto.AuditSubject">
        <choose>
            <when test="type == 'USER'">SELECT id, COALESCE(NULLIF(nickname,''), username) AS name, username AS code FROM sys_user</when>
            <when test="type == 'ROLE'">SELECT id, name, code FROM sys_role</when>
            <when test="type == 'DEPT'">SELECT id, name, NULL AS code FROM sys_dept</when>
            <when test="type == 'MENU'">SELECT id, name, route_name AS code FROM sys_menu</when>
            <when test="type == 'IP_BLOCK'">SELECT id, source_ip AS name, NULL AS code FROM sys_ip_block</when>
            <otherwise>SELECT id, NULL AS name, NULL AS code FROM sys_user</otherwise>
        </choose>
        WHERE
        <if test="type != 'USER' and type != 'ROLE' and type != 'DEPT' and type != 'MENU' and type != 'IP_BLOCK'">1=0 AND</if>
        <choose>
            <when test="ids != null and !ids.isEmpty()">
                id IN <foreach collection="ids" item="id" open="(" separator="," close=")">#{id}</foreach>
            </when>
            <otherwise>1=0</otherwise>
        </choose>
    </select>
</mapper>

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/video-ai/schemas/task-spec-1.0.json",
  "title": "Video AI TaskSpec 1.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "taskId",
    "taskVersion",
    "assignmentId",
    "assignmentEpoch",
    "desiredState",
    "camera",
    "runtime",
    "scenarios"
  ],
  "properties": {
    "schemaVersion": { "const": "1.0" },
    "taskId": { "$ref": "#/$defs/id" },
    "taskVersion": { "type": "integer", "minimum": 1 },
    "assignmentId": { "$ref": "#/$defs/id" },
    "assignmentEpoch": { "type": "integer", "minimum": 1 },
    "desiredState": { "enum": ["RUNNING", "STOPPED"] },
    "camera": {
      "type": "object",
      "additionalProperties": false,
      "required": ["cameraId", "streamProfileId", "streamRef"],
      "properties": {
        "cameraId": { "$ref": "#/$defs/id" },
        "streamProfileId": { "$ref": "#/$defs/id" },
        "streamRef": { "$ref": "#/$defs/id" }
      }
    },
    "runtime": {
      "type": "object",
      "additionalProperties": false,
      "required": ["executor", "decodeMode", "queuePolicy", "preview", "evidence"],
      "properties": {
        "executor": { "enum": ["GENERIC_GSTREAMER", "DEEPSTREAM"] },
        "decodeMode": { "enum": ["AUTO", "CPU", "GPU"] },
        "queuePolicy": { "enum": ["LATEST", "FIFO"] },
        "preview": {
          "type": "object",
          "additionalProperties": false,
          "required": ["rawEnabled", "annotatedMode", "outputFps", "width", "height"],
          "properties": {
            "rawEnabled": { "type": "boolean" },
            "annotatedMode": { "enum": ["OFF", "ON_DEMAND", "ALWAYS"] },
            "outputFps": { "type": "number", "exclusiveMinimum": 0, "maximum": 60 },
            "width": { "type": "integer", "minimum": 160, "maximum": 7680 },
            "height": { "type": "integer", "minimum": 90, "maximum": 4320 }
          }
        },
        "evidence": {
          "type": "object",
          "additionalProperties": false,
          "required": ["saveRawImage", "saveAnnotatedImage", "preRecordSeconds", "postRecordSeconds"],
          "properties": {
            "saveRawImage": { "type": "boolean" },
            "saveAnnotatedImage": { "type": "boolean" },
            "preRecordSeconds": { "type": "integer", "minimum": 0, "maximum": 300 },
            "postRecordSeconds": { "type": "integer", "minimum": 0, "maximum": 300 }
          }
        }
      }
    },
    "scenarios": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "items": { "$ref": "#/$defs/scenario" }
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[a-fA-F0-9]{64}$"
    },
    "scenario": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "taskScenarioId",
        "scenarioCode",
        "scenarioReleaseVersion",
        "inferFps",
        "trackFps",
        "model",
        "plugin",
        "params"
      ],
      "properties": {
        "taskScenarioId": { "$ref": "#/$defs/id" },
        "scenarioCode": { "$ref": "#/$defs/id" },
        "scenarioReleaseVersion": { "type": "string", "minLength": 1, "maxLength": 64 },
        "inferFps": { "type": "number", "exclusiveMinimum": 0, "maximum": 60 },
        "trackFps": { "type": "number", "minimum": 0, "maximum": 120 },
        "model": {
          "type": "object",
          "additionalProperties": false,
          "required": ["modelVersionId", "artifactSha256"],
          "properties": {
            "modelVersionId": { "$ref": "#/$defs/id" },
            "artifactSha256": { "$ref": "#/$defs/sha256" }
          }
        },
        "plugin": {
          "type": "object",
          "additionalProperties": false,
          "required": ["pluginVersionId", "apiVersion"],
          "properties": {
            "pluginVersionId": { "$ref": "#/$defs/id" },
            "apiVersion": { "type": "string", "minLength": 1, "maxLength": 32 }
          }
        },
        "params": { "type": "object" }
      }
    }
  }
}

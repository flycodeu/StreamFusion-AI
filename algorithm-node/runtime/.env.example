# Copy to .env.local. Environment variables override this file.
SF_RUNTIME_HOST=127.0.0.1
SF_RUNTIME_PORT=8101
SF_RUNTIME_WORK_DIR=.run
SF_RUNTIME_HTTP_KEEPALIVE_SECONDS=5
SF_RUNTIME_SHUTDOWN_GRACE_SECONDS=15
SF_RUNTIME_LOG_LEVEL=INFO
SF_RUNTIME_LOG_MAX_BYTES=10485760
SF_RUNTIME_LOG_BACKUPS=5
SF_RUNTIME_DOCS_ENABLED=true

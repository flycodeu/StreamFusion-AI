# Copy to .env.local. Environment variables override this file.
SF_AGENT_HOST=127.0.0.1
SF_AGENT_PORT=8100
SF_AGENT_WORK_DIR=.run
SF_AGENT_HTTP_KEEPALIVE_SECONDS=5
SF_AGENT_SHUTDOWN_GRACE_SECONDS=15
SF_AGENT_LOG_LEVEL=INFO
SF_AGENT_LOG_MAX_BYTES=10485760
SF_AGENT_LOG_BACKUPS=5
SF_AGENT_DOCS_ENABLED=true
